{
  "$id": "https://erkasa.studio/contracts/task-cancel.schema.json",
  "title": "task-cancel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "erkasa.task-cancel/1"
    },
    "messageId": {
      "type": "string",
      "minLength": 8
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stepId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "enum": [
        "CANCELLED",
        "TIMEOUT"
      ]
    }
  },
  "required": [
    "schema",
    "messageId",
    "runId",
    "stepId",
    "attempt",
    "fence",
    "reason"
  ],
  "additionalProperties": false
}
