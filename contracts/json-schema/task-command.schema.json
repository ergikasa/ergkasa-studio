{
  "$id": "https://erkasa.studio/contracts/task-command.schema.json",
  "title": "task-command",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "erkasa.task/1"
    },
    "messageId": {
      "type": "string",
      "minLength": 8
    },
    "taskType": {
      "type": "string",
      "enum": [
        "director.plan",
        "script.write",
        "storyboard.build",
        "visual.plan",
        "assets.resolve",
        "voice.synthesize",
        "subtitle.build",
        "audio.plan",
        "timeline.compile",
        "render.chunk",
        "render.finalize"
      ]
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stepId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "ref": {
            "type": "string",
            "pattern": "^(s3|file):\\/\\/.+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "params": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "traceId": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "messageId",
    "taskType",
    "runId",
    "stepId",
    "attempt",
    "idempotencyKey",
    "inputs",
    "deadline"
  ],
  "additionalProperties": false
}
