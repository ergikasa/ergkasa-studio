{
  "$id": "https://erkasa.studio/contracts/script.schema.json",
  "title": "script",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "erkasa.script/1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "theme": {
      "type": "string",
      "enum": [
        "psychology",
        "money",
        "growth",
        "philosophy",
        "science",
        "decisions",
        "everyday"
      ]
    },
    "language": {
      "type": "string",
      "const": "en"
    },
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "cast": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "protagonist",
              "supporting"
            ]
          },
          "characterId": {
            "type": "string",
            "pattern": "^[a-z]+_[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "role",
          "characterId",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "promise": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "opening": {
      "type": "string",
      "enum": [
        "paradox",
        "question",
        "situation",
        "contrast",
        "fact"
      ]
    },
    "shape": {
      "type": "string",
      "enum": [
        "two_paths",
        "case_file",
        "myth_vs_mechanism",
        "one_moment",
        "thought_experiment",
        "rewind",
        "everyday_object"
      ]
    },
    "takeaway": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "principle",
            "question",
            "tool"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "claims": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "study",
              "history",
              "statistic",
              "quote",
              "definition"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "to_verify",
              "widely_known",
              "hypothetical"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "text",
          "kind",
          "status",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "scenes": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "visualIdea": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "emphasis": {
            "type": "string",
            "maxLength": 60
          },
          "beat": {
            "type": "string",
            "enum": [
              "hook",
              "problem",
              "concept",
              "situation",
              "analysis",
              "conclusion",
              "relate",
              "tension",
              "explain",
              "twist",
              "turn",
              "resolve"
            ]
          },
          "setting": {
            "type": "string",
            "maxLength": 120
          },
          "action": {
            "type": "string",
            "maxLength": 200
          },
          "emotion": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "sceneId",
          "narration",
          "visualIdea"
        ],
        "additionalProperties": false
      }
    },
    "estimatedSec": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema",
    "title",
    "topic",
    "theme",
    "language",
    "hook",
    "scenes",
    "estimatedSec"
  ],
  "additionalProperties": false
}
