{
  "$id": "https://erkasa.studio/contracts/audio-plan.schema.json",
  "title": "audio-plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "erkasa.audio-plan/2"
    },
    "durationSec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "voice": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "audio": {
            "type": "string",
            "pattern": "^(s3|file):\\/\\/.+"
          },
          "startSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "sceneId",
          "audio",
          "startSec"
        ],
        "additionalProperties": false
      }
    },
    "voiceLufs": {
      "type": "number",
      "maximum": 0
    },
    "music": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z]+_[a-z0-9_]+$"
          },
          "role": {
            "type": "string",
            "enum": [
              "hook",
              "relate",
              "explain",
              "tension",
              "twist",
              "reflection",
              "turn",
              "resolve"
            ]
          },
          "section": {
            "type": "string",
            "enum": [
              "intro",
              "build",
              "peak",
              "outro"
            ]
          },
          "startSec": {
            "type": "number",
            "minimum": 0
          },
          "endSec": {
            "type": "number",
            "minimum": 0
          },
          "offsetSec": {
            "type": "number",
            "minimum": 0
          },
          "gainDb": {
            "type": "number",
            "minimum": -60,
            "maximum": 12
          },
          "fadeInSec": {
            "type": "number",
            "minimum": 0
          },
          "fadeOutSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "assetId",
          "role",
          "startSec",
          "endSec",
          "offsetSec",
          "gainDb",
          "fadeInSec",
          "fadeOutSec"
        ],
        "additionalProperties": false
      }
    },
    "ducking": {
      "type": "object",
      "properties": {
        "amountDb": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "attackMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "releaseMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "amountDb",
        "attackMs",
        "releaseMs"
      ],
      "additionalProperties": false
    },
    "sfx": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z]+_[a-z0-9_]+$"
          },
          "atSec": {
            "type": "number",
            "minimum": 0
          },
          "gainDb": {
            "type": "number",
            "minimum": -60,
            "maximum": 12
          },
          "offsetSec": {
            "type": "number",
            "minimum": 0
          },
          "maxSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "assetId",
          "atSec",
          "gainDb",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "loudness": {
      "type": "object",
      "properties": {
        "targetLufs": {
          "type": "number"
        },
        "truePeakDb": {
          "type": "number"
        }
      },
      "required": [
        "targetLufs",
        "truePeakDb"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "durationSec",
    "ducking",
    "loudness"
  ],
  "additionalProperties": false
}
