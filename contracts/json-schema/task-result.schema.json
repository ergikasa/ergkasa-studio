{
  "$id": "https://erkasa.studio/contracts/task-result.schema.json",
  "title": "task-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "erkasa.task-result/1"
    },
    "messageId": {
      "type": "string",
      "minLength": 8
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stepId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "outputs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "ref": {
            "type": "string",
            "pattern": "^(s3|file):\\/\\/.+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "workerVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "messageId",
    "runId",
    "stepId",
    "attempt",
    "status",
    "workerVersion"
  ],
  "additionalProperties": false
}
