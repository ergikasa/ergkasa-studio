{
  "name": "erkasa-studio",
  "private": true,
  "description": "Erkasa Animation Studio: code-driven 2D animated video studio (V1).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contracts:gen": "pnpm --filter @erkasa/contracts gen",
    "demo": "pnpm --filter @erkasa/engine-worker demo",
    "demo:plan": "pnpm --filter @erkasa/engine-worker demo:plan",
    "studio": "pnpm --filter @erkasa/studio dev",
    "assets:validate": "node tools/run-python.mjs tools/asset-validate/validate.py",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm assets:validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
