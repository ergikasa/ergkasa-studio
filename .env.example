# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- Database (local values match infra/docker-compose.yml) ---
ERKASA_DB_URL=jdbc:postgresql://localhost:5404/erkasa
ERKASA_DB_USER=erkasa
ERKASA_DB_PASSWORD=erkasa_local

# --- RabbitMQ (used from Phase E) ---
ERKASA_RABBIT_HOST=localhost
ERKASA_RABBIT_PORT=5672
ERKASA_RABBIT_USER=erkasa
ERKASA_RABBIT_PASSWORD=erkasa_local

# --- Artifact storage, SeaweedFS S3 API (used from Phase C) ---
ERKASA_S3_ENDPOINT=http://localhost:8333
ERKASA_S3_BUCKET=erkasa
ERKASA_S3_ACCESS_KEY=erkasa_local
ERKASA_S3_SECRET_KEY=erkasa_local_secret

# --- AI providers (used from Phase E). Real secrets: keep them only in your local .env ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

ERKASA_API_PORT=8080
